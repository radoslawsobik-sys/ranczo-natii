---
interface Props {
	title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Gospodarstwo Agroturystyczne i Mini Zoo w Rokitnie Szlacheckim." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		
		<!-- Czcionki i Ikony -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
		
		<title>{title}</title>
	</head>
	<body class="bg-stone-50 text-stone-800 antialiased relative">
		<slot />
	</body>
</html>

<style is:global>
	body { font-family: 'Plus Jakarta Sans', sans-serif; }
	h1, h2, h3, h4, .font-fun { font-family: 'Fredoka', cursive, sans-serif; }
	.hero-pattern {
		background-color: #f7faf7;
		background-image: radial-gradient(#dcf0da 1.5px, transparent 1.5px);
		background-size: 24px 24px;
	}
</style>